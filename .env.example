# 支付寶 AI 付（Vibe Pay）環境變數範例
# 複製為 .env 或放進 Cloudflare Workers Secrets，絕對不進倉庫

# 沙箱環境（測試用，不使用真實資金）
ALIPAY_SANDBOX_APP_ID=2024001234567890
ALIPAY_SANDBOX_PRIVATE_KEY=MIIEvQIBADANBg...  # 你的 RSA 私鑰 PKCS#8，僅放伺服端
ALIPAY_SANDBOX_ALIPAY_PUBLIC_KEY=MIIBIjANBgkqhk...  # 支付寶沙箱公鑰
ALIPAY_SANDBOX_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# 線上環境（上線後替換，僅放 Cloudflare Secret）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 授權簽章（Ed25519，伺服端簽發授權憑證，桌面端僅內嵌公鑰離線驗證）
AUTH_ED25519_PRIVATE_KEY=  # 僅伺服端，不進倉庫
AUTH_ED25519_PUBLIC_KEY=   # 可放進桌面應用做離線驗證

# 訂單金額（由伺服端決定，不接受客戶端篡改）
ATLAS_PRICE_CNY=0.01

# Cloudflare D1 / KV 綁定（Wrangler 設定）
# D1_DATABASE_ID=
# KV_NAMESPACE_ID=
